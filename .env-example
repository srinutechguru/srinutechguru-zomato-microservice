# ==========================================
# Environment Variables Template
# Instructor: SRINIVAS | SRINUTECHGURU
# ==========================================
# INSTRUCTIONS: Copy this file, rename it to .env, and fill in the actual values.
# DO NOT commit actual secrets to this template file.

# Application Routing (Used for local testing)
PORT=3000

# Backend API Endpoints (Prefix with REACT_APP_ for React to expose them)
REACT_APP_API_BASE_URL=http://api.zomato-clone.local/v1
REACT_APP_AUTH_SERVICE_URL=http://auth.zomato-clone.local/oauth

# Feature Toggles
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_placeholder_key_here

# Analytics or External Integrations
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
