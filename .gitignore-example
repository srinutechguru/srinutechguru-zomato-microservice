# INSTRUCTIONS: 
# Copy this file to '.gitignore' using:
#   cp .gitignore-example .gitignore
# ==========================================

# ------------------------------------------
# 1. Dependency Directories
# ------------------------------------------
# Third-party packages downloaded by npm/yarn.
# These should never be tracked in source control.
node_modules/
jspm_packages/
web_modules/

# ------------------------------------------
# 2. Build & Production Outputs
# ------------------------------------------
# Compiled static assets generated by 'npm run build'.
# The Docker multi-stage build creates these on the fly.
build/
dist/
out/
.next/

# ------------------------------------------
# 3. Environment & Secret Files (CRITICAL)
# ------------------------------------------
# Files containing sensitive API keys, DB passwords, or credentials.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12

# ------------------------------------------
# 4. Package Manager Logs & Lock Files
# ------------------------------------------
# Log files generated during dependency installation failures.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ------------------------------------------
# 5. IDE & Code Editor Configurations
# ------------------------------------------
# Developer-specific editor settings that cause merge conflicts if shared.
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.workspace

# ------------------------------------------
# 6. Operating System Files
# ------------------------------------------
# System files generated by macOS Finder or Windows Explorer.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# 7. Testing & Coverage Reports
# ------------------------------------------
# Output generated by test runners (Jest, Cypress, Karma).
coverage/
.nyc_output/
.cypress-cache/

# ------------------------------------------
# 8. Temporary Scan Artifacts (DevSecOps)
# ------------------------------------------
# Security scan outputs generated during local or CI runs.
trivyfs.txt
trivy_image_scan.txt
dependency-check-report.html
dependency-check-report.xml
